{
  "name": "spaceship-commander",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:css && wrangler dev",
    "deploy": "npm run build:css && wrangler deploy",
    "db:local": "wrangler d1 migrations apply spaceship-commander --local",
    "db:remote": "wrangler d1 migrations apply spaceship-commander --remote",
    "reset-password": "node scripts/reset-password.mjs",
    "reset-password:local": "node scripts/reset-password.mjs --local",
    "build:css": "tailwindcss -c tailwind.config.js -i src/tailwind.css -o public/tailwind.css --minify",
    "test": "TZ=Europe/Madrid node --test test/*.test.js",
    "apk": "cap sync android && cd android && JAVA_HOME=${JAVA_HOME:-/opt/homebrew/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home} ./gradlew assembleDebug && cp app/build/outputs/apk/debug/app-debug.apk ../spaceship-commander.apk"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "tailwindcss": "^3.4.19",
    "wrangler": "^4.153.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261023.1": true
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2"
  }
}
